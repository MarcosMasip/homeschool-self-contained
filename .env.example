# Local development defaults (safe and self-contained)
# Copy to .env to run locally
# macOS/Windows/Linux compatible

# Core
SECRET_KEY=dev-secret
DEBUG=on
DEBUG_TOOLBAR=on
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Local dev over HTTP
IS_SECURE=off
CSRF_COOKIE_SECURE=off
SESSION_COOKIE_SECURE=off

# Files (force local filesystem; avoids S3)
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# AWS placeholders (settings access these even if not used)
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_STORAGE_BUCKET_NAME=school-desk

# Email (print emails to console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Stripe in test mode with dummy keys (no real charges possible)
STRIPE_LIVE_MODE=off
STRIPE_LIVE_SECRET_KEY=sk_live_dummy
STRIPE_TEST_SECRET_KEY=sk_test_dummy
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_dummy
DJSTRIPE_WEBHOOK_SECRET=whsec_dummy
# Disable signature validation in dev by leaving this blank
DJSTRIPE_WEBHOOK_VALIDATION=

# Sentry disabled for dev
SENTRY_ENABLED=off
SENTRY_DSN=

# Required for hashid-field
HASHID_FIELD_SALT=local-dev-salt
ALLOWED_HOSTS=*
ANYMAIL_ACCOUNT_DEFAULT_HTTP_PROTOCOL=http
AWS_ACCESS_KEY_ID=asecrettoeverybody
AWS_SECRET_ACCESS_KEY=asecrettoeverybody
AWS_STORAGE_BUCKET_NAME=some-bucket
CSRF_COOKIE_SECURE=off
DEBUG=on
DEBUG_TOOLBAR=on
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
DJSTRIPE_WEBHOOK_SECRET=
DJSTRIPE_WEBHOOK_VALIDATION=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FORMS_URLFIELD_ASSUME_HTTPS=True
GUNICORN_CMD_ARGS="--reload"
